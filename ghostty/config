# theme
# theme = dark:nvim_dark,light:nvim_light
theme = dark:nightfox,light:dayfox
font-size = 14
config-file = ~/.config/ghostty/local.config

# default shell
command = /usr/bin/zsh

# cursor
cursor-style = bar
cursor-style-blink = false
shell-integration-features = no-cursor

# padding
window-padding-balance = true
window-padding-color = extend-always
window-padding-x = 0
window-padding-y = 0

# window decoration
gtk-titlebar = false
window-decoration = none
window-theme = ghostty

# tabs (tmux-style)
gtk-toolbar-style = flat
gtk-tabs-location = top
# window-show-tab-bar = always
gtk-wide-tabs = false
gtk-custom-css = ~/.config/ghostty/themes/tabbar.css

# keybindings (flat, alt-based; prefix dropped)
# tmux c: new window/tab at cwd
keybind = alt+c=new_tab
# tmux v: split -h (side by side)
keybind = alt+v=new_split:right
# tmux s: split -v (top/bottom)
keybind = alt+s=new_split:down
# tmux V: even layout (equalize_splits handles all splits)
keybind = alt+shift+v=equalize_splits
# tmux x: kill pane
keybind = alt+x=close_surface

# switch tabs (tmux ctrl+alt+h/j/k/l)
keybind = alt+p=previous_tab
keybind = alt+n=next_tab

# navigate panes (nvim first, ghostty outer fallback)
keybind = performable:alt+h=goto_split:left
keybind = performable:alt+l=goto_split:right
keybind = performable:alt+k=goto_split:up
keybind = performable:alt+j=goto_split:down

# resize panes (tmux alt-shift+h/j/k/l, step 5)
keybind = alt+shift+h=resize_split:left,20
keybind = alt+shift+l=resize_split:right,20
keybind = alt+shift+k=resize_split:up,20
keybind = alt+shift+j=resize_split:down,20

# move between zoomed panes (tmux ctrl+alt+n/p)
keybind = ctrl+alt+n=goto_split:left
keybind = ctrl+alt+p=goto_split:right

