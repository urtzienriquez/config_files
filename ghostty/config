# theme
# theme = dark:nvim_dark,light:nvim_light
theme = dark:nightfox,light:dayfox
font-size = 14
config-file = ~/.config/ghostty/local.config

# default shell
command = /usr/bin/zsh

# cursor
cursor-style = bar
cursor-style-blink = false
shell-integration-features = no-cursor

# padding
window-padding-balance = true
window-padding-color = extend-always
window-padding-x = 0
window-padding-y = 0

# window decoration
gtk-titlebar = false
window-decoration = none
window-theme = ghostty

# no confirm when closing
confirm-close-surface = false
