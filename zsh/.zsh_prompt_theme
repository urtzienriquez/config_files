# -------------------------------
# Git (minimal via vcs_info)
# -------------------------------
autoload -Uz vcs_info
precmd() { vcs_info }

# Only enable git
zstyle ':vcs_info:*' enable git

# Show only branch name
zstyle ':vcs_info:git:*' formats ' %F{244} %b %f'

setopt prompt_subst

# -------------------------------
# Vi mode indicator + cursor shape
# -------------------------------
function zle-line-init zle-keymap-select {
    VI_MODE_SYMBOL="${${KEYMAP/vicmd/}/(main|viins)/}"

    case $KEYMAP in
        vicmd)      echo -ne '\e[2 q' ;;  # normal -> steady block
        viins|main) echo -ne '\e[6 q' ;;  # insert  -> steady bar
    esac

    zle reset-prompt
}
zle -N zle-line-init
zle -N zle-keymap-select

function _cursor_beam_preexec { echo -ne '\e[6 q' }
autoload -Uz add-zsh-hook
add-zsh-hook preexec _cursor_beam_preexec

echo -ne '\e[6 q'  # set cursor on shell startup

# -------------------------------
# Prompt
# -------------------------------
PROMPT='%F{cyan}%~%f${vcs_info_msg_0_}
%F{%(?.green.red)}${VI_MODE_SYMBOL}%f '
