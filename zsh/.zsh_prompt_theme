# -------------------------------
# Git (fork-free, direct .git/HEAD read)
# -------------------------------
function _fast_git_branch {
    local dir=${PWD:A}
    while [[ $dir != / && ! -e $dir/.git ]]; do
        dir=${dir:h}
    done
    [[ -e $dir/.git ]] || { _git_branch=""; return }

    local gitdir=$dir/.git
    [[ -f $gitdir ]] && gitdir=${${"$(<$gitdir)"}#gitdir: }  # handle worktrees

    local head
    head=$(<$gitdir/HEAD) 2>/dev/null || { _git_branch=""; return }

    if [[ $head == "ref: refs/heads/"* ]]; then
        _git_branch=" %F{244} ${head#ref: refs/heads/}%f"
    else
        _git_branch=" %F{244} ${head[1,7]}%f"   # detached HEAD, short sha
    fi
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _fast_git_branch

setopt prompt_subst

# -------------------------------
# Prompt
# -------------------------------
PROMPT='%F{cyan}%~%f${_git_branch}
 '
