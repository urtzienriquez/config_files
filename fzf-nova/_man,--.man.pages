#!/usr/bin/env bash
# modified from https://github.com/gotbletu/fzf-nova
FZF_CONFIG="${FZF_CONFIG:-$HOME/.config/zsh/.fzf_config}"
: "${FZF_THEME_OPTS:=$(grep -m1 '^--color' "$FZF_CONFIG" 2>/dev/null)}"
export FZF_THEME_OPTS

export FZF_DEFAULT_OPTS="$FZF_THEME_OPTS -e -i --reverse --info=right --scroll-off=5 --tiebreak=index --bind 'home:first,end:last,tab:down,shift-tab:up' --bind 'ctrl-t:first,ctrl-b:last'"
man -k . | fzf -q "$1" --prompt='manpages: ' --preview-window down \
  --preview $'echo {} | tr -d \'()\' | awk \'{printf "%s ", $2} {print $1}\' | xargs -r man' \
  | tr -d '()' | awk '{printf "%s ", $2} {print $1}' | xargs -r man
